diff --git a/src/shared/automation-completion-marker.ts b/src/shared/automation-completion-marker.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0ae260705d8edfdbaae8c010ba15f9367a1cba4e
--- /dev/null
+++ b/src/shared/automation-completion-marker.ts
@@ -0,0 +1,15 @@
+/**
+ * One-shot agents receive the token through their environment, never in the
+ * prompt text. Their final tool action expands it into this marker, so a clean
+ * process exit cannot turn an intermediate "waiting for background work"
+ * message into a completed automation run.
+ */
+export const AUTOMATION_COMPLETION_TOKEN_ENV_VAR = 'ORCA_AUTOMATION_COMPLETION_TOKEN'
+
+export function formatAutomationCompletionMarker(token: string): string {
+  return `ORCA_AUTOMATION_COMPLETE:${token}`
+}
+
+export function hasAutomationCompletionMarker(output: string, token: string): boolean {
+  return output.includes(formatAutomationCompletionMarker(token))
+}
