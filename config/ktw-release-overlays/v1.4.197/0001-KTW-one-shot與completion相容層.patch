+    wait.satisfied &&
+    wait.exitCause?.kind === 'exited' &&
+    wait.exitCause.exitCode === 0 &&
+    hasAutomationCompletionMarker(outputSnapshot?.content ?? '', completionToken)
+  ) {
+    return { status: 'completed', outputSnapshot, error: null }
+  }
+  const detail =
+    wait.exitCause?.kind === 'exited' && wait.exitCause.exitCode === 0
+      ? ' cleanly without its run-scoped completion marker'
+      : wait.exitCause
