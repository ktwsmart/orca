@@ -0,0 +1,58 @@
+import { useAppStore } from '@/store'
+import { settleTabPtyBinding } from '@/lib/agent-background-session-exit'
+import type { LaunchAgentBackgroundSessionArgs } from '@/lib/agent-background-session-contract'
+import type { createBackgroundAgentStatusConsumer } from '@/lib/background-agent-status-consumer'
+import type { createSshBackgroundStartupDelivery } from '@/lib/ssh-background-startup-delivery'
+import type { TerminalExitCause } from '../../../shared/terminal-exit-cause'
+
+type BackgroundStatusConsumer = ReturnType<typeof createBackgroundAgentStatusConsumer>
+type SshStartupDelivery = ReturnType<typeof createSshBackgroundStartupDelivery>
+
+export function createAgentBackgroundIoCoordinator(args: {
+  getPaneKey: () => string
+  getPtyId: () => string
+  getTabId: () => string | null
+  getUnsubscribeData: () => () => void
+  getUnsubscribeExit: () => () => void
+  sshStartupDelivery: SshStartupDelivery
+  agentStatusConsumer: BackgroundStatusConsumer
+  onData: LaunchAgentBackgroundSessionArgs['onData']
+  onExit: LaunchAgentBackgroundSessionArgs['onExit']
+}): {
+  handleData: (data: string) => void
+  handleExit: (ptyId: string, code: number, cause?: TerminalExitCause) => void
+  markHandled: () => void
+} {
+  let handled = false
+
+  return {
+    handleData(data) {
+      data = args.sshStartupDelivery.handleData(data)
+      args.onData?.(data)
+      args.sshStartupDelivery.schedule(args.getPtyId())
+      args.agentStatusConsumer.consume(data)
+    },
+    handleExit(ptyId, code, cause) {
+      if (handled) {
+        return
+      }
+      handled = true
+      args.getUnsubscribeExit()()
+      args.getUnsubscribeData()()
+      args.sshStartupDelivery.clear()
+      const tabId = args.getTabId()
+      if (tabId) {
+        settleTabPtyBinding(tabId, ptyId, code)
+      }
+      useAppStore.getState().clearAgentLaunchConfig(args.getPaneKey())
+      if (cause) {
+        args.onExit?.(ptyId, code, cause)
+      } else {
+        args.onExit?.(ptyId, code)
+      }
+    },
+    markHandled() {
+      handled = true
+    }
+  }
+}
