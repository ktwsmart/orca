+    wait.satisfied &&
+    wait.exitCause?.kind === 'exited' &&
+    wait.exitCause.exitCode === 0
+  ) {
+    return { status: 'completed', outputSnapshot, error: null }
+  }
+  const detail = wait.exitCause
+    ? `: ${describeTerminalExitCause(wait.exitCause)}`
+    : typeof wait.exitCode === 'number'
+      ? ` without a verified exit cause (reported code ${wait.exitCode})`
+      : ' without a verified exit cause or exit code'
